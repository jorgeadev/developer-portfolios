{
	"name": "developer-portfolios",
	"version": "1.0.0",
	"private": true,
	"description": "A curated collection of open-source developer portfolio templates",
	"scripts": {
		"dev:portfolio": "pnpm --filter developer-portfolio dev",
		"dev:portfolio-2": "pnpm --filter developer-portfolio-2 start",
		"dev:github": "pnpm --filter github-portfolio dev",
		"dev:tedy": "pnpm --filter tedydev-portfolio dev",
		"dev:vivek": "pnpm --filter vivekneupane-portfolio dev",
		"build:portfolio": "pnpm --filter developer-portfolio build",
		"build:portfolio-2": "pnpm --filter developer-portfolio-2 build",
		"build:github": "pnpm --filter github-portfolio build",
		"build:tedy": "pnpm --filter tedydev-portfolio build",
		"build:vivek": "pnpm --filter vivekneupane-portfolio build",
		"build:all": "pnpm --filter '*' build",
		"lint:all": "pnpm --filter '*' lint",
		"install:all": "pnpm install",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"prettier": "3.5.3"
	}
}
